# ============================================================================
# openkore AI — All Environment Variables (AI_sidecar/.env)
# ============================================================================
# Copy this file to AI_sidecar/.env and uncomment/adjust as needed.
# All values shown are defaults from config.py.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
OPENKORE_AI_APP_NAME=openkore-ai-sidecar
OPENKORE_AI_ENV=development
OPENKORE_AI_HOST=127.0.0.1
OPENKORE_AI_PORT=18081
OPENKORE_AI_LOG_LEVEL=INFO
OPENKORE_AI_LOG_JSON=1
OPENKORE_AI_ENABLE_DOCS=1
OPENKORE_AI_CONTRACT_VERSION=v1

# ── Action Queue ────────────────────────────────────────────────────────────
# OPENKORE_AI_ACTION_DEFAULT_TTL_SECONDS=120
# OPENKORE_AI_ACTION_MAX_QUEUE_PER_BOT=128

# ── Snapshot Cache ──────────────────────────────────────────────────────────
# OPENKORE_AI_SNAPSHOT_CACHE_TTL_SECONDS=120

# ── Telemetry ───────────────────────────────────────────────────────────────
# OPENKORE_AI_TELEMETRY_MAX_PER_BOT=500
# OPENKORE_AI_TELEMETRY_OPERATIONAL_WINDOW_MINUTES=60
# OPENKORE_AI_TELEMETRY_RECENT_INCIDENTS_LIMIT=100
# OPENKORE_AI_TELEMETRY_BACKLOG_MAX_EVENTS=10000

# ── Latency Budgets ─────────────────────────────────────────────────────────
# OPENKORE_AI_LATENCY_BUDGET_MS=500
# OPENKORE_AI_REFLEX_LATENCY_BUDGET_MS=100
# OPENKORE_AI_REFLEX_TRIGGER_HISTORY_PER_BOT=1000

# ── Persistence ─────────────────────────────────────────────────────────────
# OPENKORE_AI_SQLITE_PATH=AI_sidecar/data/sidecar.sqlite
# OPENKORE_AI_SQLITE_BUSY_TIMEOUT_MS=300
# OPENKORE_AI_PERSISTENCE_SNAPSHOT_HISTORY_PER_BOT=5000
# OPENKORE_AI_PERSISTENCE_AUDIT_HISTORY=50000

# ── Memory ──────────────────────────────────────────────────────────────────
# OPENKORE_AI_MEMORY_BACKEND=sqlite          # sqlite | openmemory | auto
# OPENKORE_AI_MEMORY_OPENMEMORY_MODE=local
# OPENKORE_AI_MEMORY_OPENMEMORY_PATH=AI_sidecar/data/openmemory.sqlite
# OPENKORE_AI_MEMORY_EMBEDDING_DIMENSIONS=384
# OPENKORE_AI_MEMORY_EMBEDDING_MODE=local_hash   # local_hash | provider
# OPENKORE_AI_MEMORY_EMBEDDING_PROVIDER=ollama   # ollama | openai | deepseek
# OPENKORE_AI_MEMORY_EMBEDDING_MODEL=
# OPENKORE_AI_MEMORY_SEMANTIC_CANDIDATES=500
# OPENKORE_AI_MEMORY_DEFAULT_SEARCH_LIMIT=5

# ── LLM Provider (DeepSeek) ─────────────────────────────────────────────────
# OPENKORE_AI_PROVIDER_DEEPSEEK_ENABLED=1
# OPENKORE_AI_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENKORE_AI_PROVIDER_DEEPSEEK_API_KEY=
# OPENKORE_AI_PROVIDER_DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash
# OPENKORE_AI_PROVIDER_DEEPSEEK_TACTICAL_MODEL=deepseek-v4-flash
# OPENKORE_AI_PROVIDER_DEEPSEEK_STRATEGIC_MODEL=deepseek-v4-flash
# OPENKORE_AI_PROVIDER_DEEPSEEK_REFLECTION_MODEL=deepseek-v4-flash
# OPENKORE_AI_PROVIDER_DEEPSEEK_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM Provider (OpenAI) ───────────────────────────────────────────────────
# OPENKORE_AI_PROVIDER_OPENAI_ENABLED=0
# OPENKORE_AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
# OPENKORE_AI_PROVIDER_OPENAI_API_KEY=
# OPENKORE_AI_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o-mini
# OPENKORE_AI_PROVIDER_OPENAI_TACTICAL_MODEL=gpt-4o-mini
# OPENKORE_AI_PROVIDER_OPENAI_STRATEGIC_MODEL=gpt-4o-mini
# OPENKORE_AI_PROVIDER_OPENAI_REFLECTION_MODEL=gpt-4o-mini
# OPENKORE_AI_PROVIDER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM Provider (Ollama — local GPU) ───────────────────────────────────────
# OPENKORE_AI_PROVIDER_OLLAMA_ENABLED=0
# OPENKORE_AI_PROVIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPENKORE_AI_PROVIDER_OLLAMA_DEFAULT_MODEL=qwen3.6:35b-a3b-q4_K_M
# OPENKORE_AI_PROVIDER_OLLAMA_TACTICAL_MODEL=qwen3.6:35b-a3b-q4_K_M
# OPENKORE_AI_PROVIDER_OLLAMA_STRATEGIC_MODEL=qwen3.6:35b-a3b-q4_K_M
# OPENKORE_AI_PROVIDER_OLLAMA_REFLECTION_MODEL=qwen3.6:35b-a3b-q4_K_M
# OPENKORE_AI_PROVIDER_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Provider Routing ────────────────────────────────────────────────────────
# OPENKORE_AI_PROVIDER_POLICY_JSON=
# OPENKORE_AI_LLM_TIMEOUT_SECONDS=45
# OPENKORE_AI_LLM_MAX_RETRIES=2
# OPENKORE_AI_LLM_PROMPT_MAX_CHARS=32000

# ── Cost Control ────────────────────────────────────────────────────────────
# OPENKORE_AI_LLM_COST_TIER=standard    # off | economy | standard | premium
# OPENKORE_AI_LLM_DAILY_BUDGET_TOKENS=100000
# OPENKORE_AI_LLM_MONTHLY_BUDGET_USD=10.0
# OPENKORE_AI_LLM_MAX_CALLS_PER_HOUR=30
# OPENKORE_AI_LLM_SKIP_IF_HEURISTIC=1
# OPENKORE_AI_LLM_HEURISTIC_CONFIDENCE_THRESHOLD=0.7
# OPENKORE_AI_LLM_REFLEX_ALWAYS_FIRST=1

# ── API Authentication ──────────────────────────────────────────────────────
# OPENKORE_AI_API_AUTH_ENABLED=0
# OPENKORE_AI_API_AUTH_TOKEN=

# ── Planner ─────────────────────────────────────────────────────────────────
# OPENKORE_AI_PLANNER_TACTICAL_BUDGET_MS=15000
# OPENKORE_AI_PLANNER_STRATEGIC_BUDGET_MS=30000
# OPENKORE_AI_PLANNER_TIMEOUT_SECONDS=45
# OPENKORE_AI_PLANNER_RETRIES=2

# ── Autonomy ────────────────────────────────────────────────────────────────
# OPENKORE_AI_AUTONOMY_OBJECTIVE_MAX_AGE_CYCLES=6
# OPENKORE_AI_AUTONOMY_MAX_ACTIVE_OBJECTIVES=3
# OPENKORE_AI_AUTONOMY_PRIORITY_DECAY_PER_CYCLE=0.10
# OPENKORE_AI_AUTONOMY_OBJECTIVE_ROTATION_COOLDOWN_S=20.0
# OPENKORE_AI_AUTONOMY_RANKED_OBJECTIVES=grind,recovery,economy,quest
# OPENKORE_AI_AUTONOMY_STALE_PLAN_THRESHOLD_S=60.0
# OPENKORE_AI_AUTONOMY_DEATH_RECOVERY_COOLDOWN_S=15.0
# OPENKORE_AI_AUTONOMY_RECONNECT_GRACE_S=20.0
# OPENKORE_AI_AUTONOMY_PREFERRED_GRIND_MAPS=
# OPENKORE_AI_AUTONOMY_PREFERRED_GRIND_MAP_POLICY=prefer

# ── Fleet Coordination ──────────────────────────────────────────────────────
# OPENKORE_AI_FLEET_CENTRAL_ENABLED=0
# OPENKORE_AI_FLEET_CENTRAL_BASE_URL=http://127.0.0.1:18090
# OPENKORE_AI_FLEET_REQUEST_TIMEOUT_SECONDS=8.0
# OPENKORE_AI_FLEET_OUTCOME_BACKLOG_LIMIT=2000
# OPENKORE_AI_FLEET_LOCAL_PARTITION_TTL_SECONDS=600

# ── Observability ───────────────────────────────────────────────────────────
# OPENKORE_AI_OBSERVABILITY_ENABLE_METRICS=1
# OPENKORE_AI_OBSERVABILITY_ENABLE_TRACING=1
# OPENKORE_AI_OBSERVABILITY_TRACE_MAX_TRACES=5000
# OPENKORE_AI_OBSERVABILITY_TRACE_MAX_EVENTS_PER_TRACE=200
# OPENKORE_AI_OBSERVABILITY_INCIDENT_MAX_OPEN=2000
# OPENKORE_AI_OBSERVABILITY_EXPLAINABILITY_MAX_RECORDS=10000

# ── Security ────────────────────────────────────────────────────────────────
# OPENKORE_AI_SECURITY_DOCTRINE_DENYLIST=exploit,dupe,rmt,botting service
