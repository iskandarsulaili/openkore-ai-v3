# ============================================================================
# openkore AI — All Environment Variables (AI_sidecar/.env)
# ============================================================================
# Copy this file to AI_sidecar/.env and uncomment/adjust as needed.
# All values shown are defaults from config.py.
# ============================================================================

# ── Server ──────────────────────────────────────────────────────────────────
# App name used in FastAPI title and logging.
OPENKORE_AI_APP_NAME=openkore-ai-sidecar

# Environment label (development | production | staging). Controls log verbosity
# and some safety defaults.
OPENKORE_AI_ENV=development

# Host to bind the FastAPI server to.
#   127.0.0.1  = local only (safe for single-machine setup)
#   0.0.0.0    = all interfaces (use with auth enabled)
OPENKORE_AI_HOST=127.0.0.1

# Port for the FastAPI sidecar server. Must match aiSidecar_baseUrl in
# control/ai_sidecar.txt.
OPENKORE_AI_PORT=18081

# Log level (DEBUG | INFO | WARNING | ERROR | CRITICAL).
OPENKORE_AI_LOG_LEVEL=INFO

# Output logs as JSON (1) or plain text (0). JSON is machine-parseable,
# plain text is human-readable.
OPENKORE_AI_LOG_JSON=1

# Enable /docs and /redoc Swagger UI endpoints (1=yes, 0=no).
OPENKORE_AI_ENABLE_DOCS=1

# API contract version string. Used in response headers.
OPENKORE_AI_CONTRACT_VERSION=v1

# ── Action Queue ────────────────────────────────────────────────────────────
# Default TTL in seconds for queued actions before they expire.
# Range: 1-600. Higher values keep actions longer for slow bots.
# OPENKORE_AI_ACTION_DEFAULT_TTL_SECONDS=120

# Maximum actions queued per bot. Excess proposals are rejected.
# Range: 1-4096.
# OPENKORE_AI_ACTION_MAX_QUEUE_PER_BOT=128

# ── Snapshot Cache ──────────────────────────────────────────────────────────
# How long (in seconds) a bot snapshot stays in the in-memory cache.
# Range: 1-3600. Lower = fresher data, higher = fewer DB reads.
# OPENKORE_AI_SNAPSHOT_CACHE_TTL_SECONDS=120

# ── Telemetry ───────────────────────────────────────────────────────────────
# Max telemetry entries kept per bot in the database.
# Range: 10-10000.
# OPENKORE_AI_TELEMETRY_MAX_PER_BOT=500

# Rolling window (in minutes) for operational telemetry calculations.
# Range: 1-1440 (24h).
# OPENKORE_AI_TELEMETRY_OPERATIONAL_WINDOW_MINUTES=60

# Max recent incident records kept in memory.
# Range: 1-1000.
# OPENKORE_AI_TELEMETRY_RECENT_INCIDENTS_LIMIT=100

# Max telemetry backlog events before old ones are purged.
# Range: 100-200000.
# OPENKORE_AI_TELEMETRY_BACKLOG_MAX_EVENTS=10000

# ── Latency Budgets ─────────────────────────────────────────────────────────
# Total budget in ms for the full decision pipeline (reflex + heuristic + LLM).
# Range: 1-5000ms.
# OPENKORE_AI_LATENCY_BUDGET_MS=500

# Budget in ms specifically for the reflex rule engine.
# Range: 10-1000ms.
# OPENKORE_AI_REFLEX_LATENCY_BUDGET_MS=100

# History size per bot for tracking reflex trigger outcomes.
# Range: 100-20000.
# OPENKORE_AI_REFLEX_TRIGGER_HISTORY_PER_BOT=1000

# ── Persistence ─────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to repo root or absolute).
# OPENKORE_AI_SQLITE_PATH=AI_sidecar/data/sidecar.sqlite

# SQLite busy timeout in milliseconds for concurrent access.
# Range: 50-10000ms.
# OPENKORE_AI_SQLITE_BUSY_TIMEOUT_MS=300

# How many snapshots to keep per bot in the database (rolling purge).
# Range: 100-200000.
# OPENKORE_AI_PERSISTENCE_SNAPSHOT_HISTORY_PER_BOT=5000

# Maximum audit log entries kept total.
# Range: 1000-500000.
# OPENKORE_AI_PERSISTENCE_AUDIT_HISTORY=50000

# ── Memory ──────────────────────────────────────────────────────────────────
# Backend for long-term memory storage.
#   sqlite     = local SQLite (default override in .env.example)
#   openmemory = OpenMemory vector DB (default in code)
#   auto       = try openmemory, fallback to sqlite
# OPENKORE_AI_MEMORY_BACKEND=sqlite

# OpenMemory mode (local | remote).
# OPENKORE_AI_MEMORY_OPENMEMORY_MODE=local

# Path to OpenMemory SQLite file (local mode only).
# OPENKORE_AI_MEMORY_OPENMEMORY_PATH=AI_sidecar/data/openmemory.sqlite

# Embedding vector dimensions.
# Common: 384 (nomic), 768 (gte-small), 1536 (openai/text-embedding-3-small).
# Range: 64-4096.
# OPENKORE_AI_MEMORY_EMBEDDING_DIMENSIONS=384

# Embedding calculation method.
#   local_hash = simple hash-based (no external service, fast)
#   provider   = use an LLM provider's embedding API
# OPENKORE_AI_MEMORY_EMBEDDING_MODE=local_hash

# Which provider to use for embeddings when mode=provider.
#   ollama   | openai | deepseek
# OPENKORE_AI_MEMORY_EMBEDDING_PROVIDER=ollama

# Model name for embedding provider. Leave empty to use provider default.
# Ollama examples: nomic-embed-text, all-minilm, bge-m3
# OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
# OPENKORE_AI_MEMORY_EMBEDDING_MODEL=

# Number of candidate results to retrieve from the memory store during semantic search.
# Range: 20-5000.
# OPENKORE_AI_MEMORY_SEMANTIC_CANDIDATES=500

# Default number of results returned by memory search queries.
# Range: 1-50.
# OPENKORE_AI_MEMORY_DEFAULT_SEARCH_LIMIT=5

# ── LLM Provider (DeepSeek) ─────────────────────────────────────────────────
# Enable DeepSeek as an LLM provider (1=yes, 0=no).
# OPENKORE_AI_PROVIDER_DEEPSEEK_ENABLED=1

# DeepSeek API base URL.
# OPENKORE_AI_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Your DeepSeek API key. Get one at https://platform.deepseek.com
# OPENKORE_AI_PROVIDER_DEEPSEEK_API_KEY=

# Model used for default/general LLM calls.
# Values: deepseek-chat, deepseek-reasoner, deepseek-v4-flash
# OPENKORE_AI_PROVIDER_DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Model used for tactical decisions (short-term actions, combat).
# OPENKORE_AI_PROVIDER_DEEPSEEK_TACTICAL_MODEL=deepseek-chat

# Model used for strategic planning (long-term goals, quest routing).
# OPENKORE_AI_PROVIDER_DEEPSEEK_STRATEGIC_MODEL=deepseek-chat

# Model used for self-reflection and outcome analysis.
# OPENKORE_AI_PROVIDER_DEEPSEEK_REFLECTION_MODEL=deepseek-chat

# Model used for text embeddings (when embedding_mode=provider and provider=deepseek).
# OPENKORE_AI_PROVIDER_DEEPSEEK_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM Provider (OpenAI) ───────────────────────────────────────────────────
# Enable OpenAI as an LLM provider (1=yes, 0=no).
# OPENKORE_AI_PROVIDER_OPENAI_ENABLED=1

# OpenAI API base URL (or custom endpoint).
# OPENKORE_AI_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1

# Your OpenAI API key. Get one at https://platform.openai.com
# OPENKORE_AI_PROVIDER_OPENAI_API_KEY=

# Model used for default/general LLM calls.
# Values: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo, o3-mini
# OPENKORE_AI_PROVIDER_OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Model used for tactical decisions.
# OPENKORE_AI_PROVIDER_OPENAI_TACTICAL_MODEL=gpt-4o-mini

# Model used for strategic planning.
# OPENKORE_AI_PROVIDER_OPENAI_STRATEGIC_MODEL=gpt-4o-mini

# Model used for self-reflection.
# OPENKORE_AI_PROVIDER_OPENAI_REFLECTION_MODEL=gpt-4o-mini

# Model used for text embeddings.
# OPENKORE_AI_PROVIDER_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LLM Provider (Ollama — local GPU) ───────────────────────────────────────
# Enable Ollama as an LLM provider (1=yes, 0=no).
# OPENKORE_AI_PROVIDER_OLLAMA_ENABLED=1

# Ollama server URL.
# OPENKORE_AI_PROVIDER_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model used for default/general LLM calls. Any model served by your Ollama instance.
# Common: llama3.2, qwen3.6:35b-a3b-q4_K_M, mistral, mixtral, gemma2
# OPENKORE_AI_PROVIDER_OLLAMA_DEFAULT_MODEL=qwen3.6:35b-a3b-q4_K_M

# Model used for tactical decisions.
# OPENKORE_AI_PROVIDER_OLLAMA_TACTICAL_MODEL=qwen3.6:35b-a3b-q4_K_M

# Model used for strategic planning.
# OPENKORE_AI_PROVIDER_OLLAMA_STRATEGIC_MODEL=qwen3.6:35b-a3b-q4_K_M

# Model used for self-reflection.
# OPENKORE_AI_PROVIDER_OLLAMA_REFLECTION_MODEL=qwen3.6:35b-a3b-q4_K_M

# Model used for text embeddings. Examples: nomic-embed-text, all-minilm, bge-m3
# OPENKORE_AI_PROVIDER_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── Provider Routing ────────────────────────────────────────────────────────
# JSON policy string for routing decisions to specific providers/models.
# Format: {"domain": {"provider": "provider_name", "model": "model_name"}, ...}
# Example: '{"combat": {"provider": "ollama"}, "economy": {"provider": "deepseek", "model": "deepseek-chat"}}'
# OPENKORE_AI_PROVIDER_POLICY_JSON=

# Timeout in seconds for LLM API calls.
# Range: 1-600.
# OPENKORE_AI_LLM_TIMEOUT_SECONDS=45

# Maximum retries on LLM API failure.
# Range: 0-8.
# OPENKORE_AI_LLM_MAX_RETRIES=2

# Maximum characters in prompt sent to LLM. Excess is truncated.
# Range: 1024-200000.
# OPENKORE_AI_LLM_PROMPT_MAX_CHARS=32000

# ── Cost Control ────────────────────────────────────────────────────────────
# LLM cost tier — controls how often and how much context the LLM receives.
#   off       = Reflex + heuristic only. Zero LLM calls. $0 cost.
#   economy   = 512 token context, minimal LLM usage.
#   standard  = 2K context, normal LLM usage. (default)
#   premium   = 8K context, full LLM reasoning on every decision cycle.
# OPENKORE_AI_LLM_COST_TIER=standard

# Daily token budget for LLM calls across all bots. 0 = unlimited.
# Range: 0-10000000.
# OPENKORE_AI_LLM_DAILY_BUDGET_TOKENS=100000

# Monthly USD budget for LLM API costs. 0 = unlimited.
# Range: 0-1000.
# OPENKORE_AI_LLM_MONTHLY_BUDGET_USD=10.0

# Maximum LLM calls per hour across all bots. 0 = unlimited.
# Range: 0-1000.
# OPENKORE_AI_LLM_MAX_CALLS_PER_HOUR=30

# Skip LLM entirely if the heuristic service produces high-confidence actions.
# 1 = yes, 0 = always consult LLM.
# OPENKORE_AI_LLM_SKIP_IF_HEURISTIC=1

# Confidence threshold (0.0-1.0) above which heuristic actions skip LLM.
# Higher = more LLM calls. Lower = cheaper but potentially dumber.
# OPENKORE_AI_LLM_HEURISTIC_CONFIDENCE_THRESHOLD=0.7

# Always run reflex rules before any other decision layer.
# 1 = reflex first (safe), 0 = heuristic/LLM can override reflex.
# OPENKORE_AI_LLM_REFLEX_ALWAYS_FIRST=1

# Pricing matrix for cost tracking ($/M tokens per tier).
# JSON: {"tier_name": price_per_million_tokens, ...}
# OPENKORE_AI_LLM_COST_TIER_PRICING={"off":0,"economy":0.15,"standard":0.30,"premium":0.60}

# ── API Authentication ──────────────────────────────────────────────────────
# Enable Bearer token authentication for sidecar API.
# 1 = enabled (set api_auth_token), 0 = open access (default).
# OPENKORE_AI_API_AUTH_ENABLED=0

# API auth token for Bearer authentication. If empty and auth is enabled,
# a random 32-char token is auto-generated at startup and written to
# control/sidecar_auth_token.txt for the bridge to read.
# OPENKORE_AI_API_AUTH_TOKEN=

# ── Planner ─────────────────────────────────────────────────────────────────
# Time budget in ms for tactical planning (short-term actions).
# Range: 100-120000ms.
# OPENKORE_AI_PLANNER_TACTICAL_BUDGET_MS=15000

# Time budget in ms for strategic planning (long-term goals).
# Range: 500-300000ms.
# OPENKORE_AI_PLANNER_STRATEGIC_BUDGET_MS=30000

# Timeout in seconds for planner LLM calls.
# Range: 1-600.
# OPENKORE_AI_PLANNER_TIMEOUT_SECONDS=45

# Maximum retries for planner LLM calls.
# Range: 0-8.
# OPENKORE_AI_PLANNER_RETRIES=2

# ── Autonomy ────────────────────────────────────────────────────────────────
# Maximum age in PDCA cycles before an objective is considered stale.
# Range: 1-10000 cycles.
# OPENKORE_AI_AUTONOMY_OBJECTIVE_MAX_AGE_CYCLES=6

# Maximum concurrent active objectives per bot.
# Range: 1-64.
# OPENKORE_AI_AUTONOMY_MAX_ACTIVE_OBJECTIVES=3

# Priority decay per PDCA cycle (0.0-1.0). Higher = faster priority drop.
# OPENKORE_AI_AUTONOMY_PRIORITY_DECAY_PER_CYCLE=0.10

# Cooldown in seconds before an objective can be re-selected after rotation.
# Range: 0-3600.
# OPENKORE_AI_AUTONOMY_OBJECTIVE_ROTATION_COOLDOWN_S=20.0

# Ranked priority order for objective types (comma-separated).
# Values: grind, recovery, economy, quest, exploration, social, pvp, gvg, craft
# OPENKORE_AI_AUTONOMY_RANKED_OBJECTIVES=grind,recovery,economy,quest

# Time in seconds before a plan is considered stale and needs replanning.
# Range: 1-36000 (10h).
# OPENKORE_AI_AUTONOMY_STALE_PLAN_THRESHOLD_S=60.0

# Cooldown in seconds after death before the bot tries to recover.
# Range: 0-3600.
# OPENKORE_AI_AUTONOMY_DEATH_RECOVERY_COOLDOWN_S=15.0

# Grace period in seconds after reconnect before resuming normal operation.
# Range: 0-3600.
# OPENKORE_AI_AUTONOMY_RECONNECT_GRACE_S=20.0

# Comma-separated list of preferred grind maps.
# Examples: "gef_fild08,pay_fild04,moc_fild06"
# OPENKORE_AI_AUTONOMY_PREFERRED_GRIND_MAPS=

# Policy for preferred grind maps.
#   prefer   = try preferred maps first, fallback to others
#   restrict = only use preferred maps
# OPENKORE_AI_AUTONOMY_PREFERRED_GRIND_MAP_POLICY=prefer

# ── CrewAI ──────────────────────────────────────────────────────────────────
# Enable CrewAI multi-agent orchestration (1=yes, 0=no).
# OPENKORE_AI_CREWAI_ENABLED=1

# CrewAI verbose logging (1=verbose, 0=quiet).
# OPENKORE_AI_CREWAI_VERBOSE=0

# CrewAI memory (not related to openkore memory — this is CrewAI's internal memory).
# OPENKORE_AI_CREWAI_MEMORY_ENABLED=0

# ── Fleet Coordination ──────────────────────────────────────────────────────
# Enable fleet coordination between multiple sidecar instances.
# 1 = connect to fleet central coordinator, 0 = standalone.
# OPENKORE_AI_FLEET_CENTRAL_ENABLED=1

# URL of the fleet central coordinator service.
# OPENKORE_AI_FLEET_CENTRAL_BASE_URL=http://127.0.0.1:18090

# Timeout in seconds for fleet coordination HTTP requests.
# Range: 0.1-30.
# OPENKORE_AI_FLEET_REQUEST_TIMEOUT_SECONDS=8.0

# Maximum outcomes kept in the fleet outcome backlog.
# Range: 100-200000.
# OPENKORE_AI_FLEET_OUTCOME_BACKLOG_LIMIT=2000

# TTL in seconds for local fleet partition data before refresh.
# Range: 30-86400 (24h).
# OPENKORE_AI_FLEET_LOCAL_PARTITION_TTL_SECONDS=600

# ── Observability ───────────────────────────────────────────────────────────
# Enable Prometheus-style metrics endpoint (1=yes, 0=no).
# OPENKORE_AI_OBSERVABILITY_ENABLE_METRICS=1

# Enable OpenTelemetry-style tracing (1=yes, 0=no).
# OPENKORE_AI_OBSERVABILITY_ENABLE_TRACING=1

# Maximum traces kept in the tracing buffer before rotation.
# Range: 100-200000.
# OPENKORE_AI_OBSERVABILITY_TRACE_MAX_TRACES=5000

# Maximum events per trace.
# Range: 10-2000.
# OPENKORE_AI_OBSERVABILITY_TRACE_MAX_EVENTS_PER_TRACE=200

# Maximum open incidents before auto-resolution.
# Range: 100-100000.
# OPENKORE_AI_OBSERVABILITY_INCIDENT_MAX_OPEN=2000

# Maximum records kept in the explainability log.
# Range: 500-200000.
# OPENKORE_AI_OBSERVABILITY_EXPLAINABILITY_MAX_RECORDS=10000

# ── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of forbidden behaviors (doctrine denylist).
# Commands matching these patterns are rejected by the security auditor.
# OPENKORE_AI_SECURITY_DOCTRINE_DENYLIST=exploit,dupe,rmt,botting service
