[Unit]
Description=OpenKore AI v3 Fleet (sidecar + all bots, persistent)
After=network.target
Wants=rathena-login.service rathena-char.service rathena-map.service

[Service]
Type=simple
User=lot399
Group=lot399
WorkingDirectory=/home/lot399/openkore-ai-v3
# Run a fleet supervisor that launches the sidecar + all bots with setsid so
# they leave this unit's cgroup and survive session/systemd reaping. Type=simple
# keeps the unit active while the supervisor sleeps, so it is never "exited".
ExecStart=/home/lot399/openkore-ai-v3/deploy/fleet_supervisor.sh
Restart=on-failure
RestartSec=10
KillMode=process

[Install]
WantedBy=multi-user.target
