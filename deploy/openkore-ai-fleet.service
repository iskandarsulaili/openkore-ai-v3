[Unit]
Description=OpenKore AI v3 Fleet (sidecar + all bots, persistent)
After=network.target
Wants=rathena-login.service rathena-char.service rathena-map.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=lot399
Group=lot399
WorkingDirectory=/home/lot399/openkore-ai-v3
# Start the sidecar + all bots. KillMode=process keeps the nohup'd children
# (sidecar + bots) alive when this oneshot script exits, so the fleet persists
# across sessions instead of being reaped with the unit's cgroup.
ExecStart=/bin/bash -c 'bash /home/lot399/openkore-ai-v3/start.sh all > /home/lot399/openkore-ai-v3/logs/fleet-boot.log 2>&1'
KillMode=process
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
